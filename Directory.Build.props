<Project>

  <PropertyGroup>
    <!-- The package is SafeTensors.NET; the namespace is SafeTensors. The ".NET" suffix
         disambiguates the package on NuGet against the Rust/Python originals, but putting
         it in every using directive would be noise. Set explicitly so nobody "fixes" it. -->
    <RootNamespace>SafeTensors</RootNamespace>

    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>false</ImplicitUsings>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <WarningsAsErrors>nullable</WarningsAsErrors>

    <!-- Deterministic, source-linked builds. SourceLink ships in the SDK since .NET 8,
         so this needs no PackageReference. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Shared package identity. Only projects that opt in with IsPackable are published. -->
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>Rhuan Alves Inocencio</Authors>
    <Company>SafeTensors.NET</Company>
    <Copyright>Copyright (c) 2026 Rhuan Alves Inocencio and SafeTensors.NET contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Rhuan09/SafeTensors.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Rhuan09/SafeTensors.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

</Project>

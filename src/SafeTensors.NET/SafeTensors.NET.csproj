<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net6.0 left support in November 2024 and is deliberately not targeted.
         netstandard2.0 keeps the door open for .NET Framework 4.6.1+ and Unity. -->
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>

    <PackageId>SafeTensors.NET</PackageId>
    <Title>SafeTensors.NET</Title>
    <Description>Zero-copy reader and writer for the SafeTensors tensor format. Memory-mapped access with no per-tensor copy, header-only inspection of multi-gigabyte checkpoints, sharded Hugging Face models, streaming, and a Native AOT C ABI.</Description>
    <PackageTags>safetensors;tensors;deep-learning;machine-learning;huggingface;pytorch;zero-copy;mmap;ai;llm</PackageTags>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Float16's software conversion path is compiled on every TFM and verified against
         Half in the test suite, so the netstandard2.0 build is not a second, untested one. -->
    <InternalsVisibleTo Include="SafeTensors.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="System.Buffers" />
    <PackageReference Include="System.Memory" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

</Project>

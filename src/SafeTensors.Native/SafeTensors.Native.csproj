<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <AssemblyName>safetensors</AssemblyName>
    <IsPackable>false</IsPackable>

    <!-- Nothing here is reachable from managed code, so the trimmer would otherwise
         remove every export. -->
    <TrimMode>partial</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SafeTensors.NET\SafeTensors.NET.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="safetensors.h" />
  </ItemGroup>

</Project>
